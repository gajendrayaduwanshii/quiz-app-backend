# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Public URLs
STRAPI_URL=http://localhost:1337
CORS_ORIGIN=http://localhost:3000

# Generate unique, cryptographically secure values for every environment.
# APP_KEYS must contain at least two comma-separated keys.
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-api-token-salt
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
JWT_SECRET=replace-with-users-permissions-jwt-secret
ENCRYPTION_KEY=replace-with-encryption-key

# Local development uses SQLite by default.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi Cloud provides PostgreSQL and injects its database variables.
# Do not add DATABASE_* variables in Strapi Cloud unless using an external DB.
